<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FrameKit.Setup.App.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <SolidColorBrush x:Key="SteamBlue" Color="#1A9FFF" />
    <SolidColorBrush x:Key="Muted" Color="#8B929A" />
    <SolidColorBrush x:Key="Faint" Color="#5E656E" />
    <SolidColorBrush x:Key="Card" Color="#23262E" />
    <SolidColorBrush x:Key="Good" Color="#59BF40" />
    <SolidColorBrush x:Key="Bad" Color="#E5483B" />
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="Background" Value="#171A21" />
    </Style>
    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
    </Style>
    <Style Selector="TextBlock.body">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="LineHeight" Value="20" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{StaticResource SteamBlue}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="22,9" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#47B4FF" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Padding" Value="18,9" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource Card}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="HyperlinkButton.footer">
      <Setter Property="Padding" Value="4,2" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="HyperlinkButton.footer /template/ ContentPresenter">
      <Setter Property="Foreground" Value="{StaticResource Faint}" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="HyperlinkButton.footer:pointerover /template/ ContentPresenter">
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
    </Style>
    <Style Selector="Button.corner">
      <Setter Property="Padding" Value="0,2" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>
    <Style Selector="Button.corner /template/ ContentPresenter">
      <Setter Property="Foreground" Value="{StaticResource Faint}" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.corner:pointerover /template/ ContentPresenter">
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.corner:pressed /template/ ContentPresenter">
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.notices">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.notices ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Focusable" Value="False" />
    </Style>
    <Style Selector="ListBox.notices ListBoxItem /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.notices ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.notices ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="HyperlinkButton.report">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="HyperlinkButton.report /template/ ContentPresenter">
      <Setter Property="Foreground" Value="{StaticResource SteamBlue}" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ToggleButton.details">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="16,10" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="ToggleButton.details /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Card}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ToggleButton.details:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#2C3039" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="ToggleButton.details:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Card}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="ToggleButton.details:checked:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#2C3039" />
    </Style>
    <Style Selector="ToggleButton.details Path.chevron">
      <Setter Property="Stroke" Value="{StaticResource Muted}" />
      <Setter Property="StrokeThickness" Value="1.5" />
    </Style>
    <Style Selector="ToggleButton.details:checked Path.chevron">
      <Setter Property="RenderTransform" Value="rotate(180deg)" />
    </Style>
    <Style Selector="Border.step">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="CornerRadius" Value="13" />
      <Setter Property="Background" Value="{StaticResource SteamBlue}" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
  </Application.Styles>
</Application>
