[Unit]
Description=FrameKit panel in Steam's Quick Access menu
ConditionDirectoryNotEmpty=%h/@appsRoot@/@sharedDir@/@panelModulesDir@

[Service]
Type=simple
ExecStart=%h/@appsRoot@/@sharedDir@/@panelHome@/@currentLink@/@panelBinary@ run
Restart=on-failure
RestartSec=5
Nice=10
CPUAffinity=0-2

[Install]
WantedBy=default.target
